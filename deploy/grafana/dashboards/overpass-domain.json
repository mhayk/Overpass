    {
      "id": 18,
      "type": "timeseries",
      "title": "Allocation latency p50 / p95 / p99",
      "description": "The line is the 800ms SLO PlannerRoundsSlow alerts on. It matters more than a latency number usually does: the planner holds an advisory lock for the whole round, so a slow round blocks every other round for that satellite and bucket.\n\nSliced by policy, because which allocator is configured is the dominant term \u2014 see docs/policy-benchmark.md.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le, policy) (rate(overpass_allocation_duration_ms_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{policy}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, policy) (rate(overpass_allocation_duration_ms_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{policy}}",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le, policy) (rate(overpass_allocation_duration_ms_bucket[$__rate_interval])))",
          "legendFormat": "p99 {{policy}}",
          "range": true,
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 8,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "orange",
                "value": 800
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
