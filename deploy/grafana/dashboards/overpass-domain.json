    {
      "id": 24,
      "type": "timeseries",
      "title": "TLE age by satellite",
      "description": "Per satellite rather than a distribution: with nine satellites these labelled gauges ARE the distribution, and they answer the question a histogram cannot \u2014 WHICH element set is old.\n\nOrange at 48h is TleAgeing: a refresh is due, nothing is failing. Red at 72h is TleStale: feasibility now REFUSES to compute against this element set rather than publishing a drifted access window, and requests naming that satellite fail with TLE_STALE.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 37
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "overpass_tle_age_hours",
          "legendFormat": "{{satellite_id}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 8,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "h",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "orange",
                "value": 48
              },
              {
                "color": "red",
                "value": 72
              }
            ]
          }
        },
