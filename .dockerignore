# The application Dockerfiles build from the repo root (their modules reach
# gen/go and lib/go through replace directives), so this file is what keeps
# `docker compose build` from shipping gigabytes of local state into every
# build context. Biggest offenders first.
.git
web/node_modules
web/.next
# Generated by web's postinstall; a locally-generated copy leaking into the
# context could disagree with the cesium version `npm ci` just installed.
web/public/cesium
services/feasibility/.venv
services/feasibility/.uv-cache
**/__pycache__
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
