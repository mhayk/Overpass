# Copy to .env and adjust. Every variable has a working default in
# docker-compose.yml, so an empty .env (or none at all) still brings up a
# functioning stack — the defaults are the documentation.
#
#   cp .env.example .env

# --- PostgreSQL ---------------------------------------------------------
# Credentials are deliberately trivial. There is no authentication anywhere in
# this system (see README scope cuts) and nothing here is worth protecting;
# pretending otherwise with a generated password would be security theatre.
POSTGRES_USER=overpass
POSTGRES_PASSWORD=overpass
POSTGRES_DB=overpass
# 5433 on the host to avoid colliding with a local Postgres. Inside the
# compose network services still connect to postgres:5432.
POSTGRES_PORT=5433

# --- NATS ---------------------------------------------------------------
NATS_PORT=4222
NATS_MONITOR_PORT=8222

# --- Observability ------------------------------------------------------
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
PROMETHEUS_PORT=9090
# 3001, not 3000 — the Next.js frontend takes 3000 in M1.
GRAFANA_PORT=3001

# --- Domain configuration (M1+) -----------------------------------------
# Present now so the knobs are visible and reviewable before the code that
# reads them exists.

# Satellites to fetch from Celestrak at seed time. Real SAR platforms, real
# public element sets.
OVERPASS_CONSTELLATION=SENTINEL-1A,ICEYE-X7,ICEYE-X12,CAPELLA-10,CAPELLA-14,SAOCOM-1A

# TLE staleness thresholds, in hours. Beyond STALE, feasibility REFUSES to
# compute and emits feasibility.failed.v1 rather than publishing a drifted
# access window — a confidently wrong answer is worse than no answer.
OVERPASS_TLE_AGING_HOURS=24
OVERPASS_TLE_STALE_HOURS=48
OVERPASS_TLE_CACHE_PATH=/app/testdata/tle/cache

# Sensor geometry envelope. The valid incidence band is configuration rather
# than contract, so a differently specified sensor does not require a schema
# version.
OVERPASS_MIN_INCIDENCE_DEG=15
OVERPASS_MAX_INCIDENCE_DEG=45
OVERPASS_MAX_SQUINT_DEG=25

# Planning rounds. Round identity is (satellite_id, bucket_start), which is
# also the advisory-lock key: per-satellite, matching the granularity of the
# non-overlap invariant, so the constellation still plans in parallel.
OVERPASS_HORIZON_BUCKET_HOURS=6
OVERPASS_MAX_HORIZON_DAYS=7
OVERPASS_ROUND_CADENCE_SECONDS=60
OVERPASS_ROUND_DEBOUNCE_SECONDS=2
OVERPASS_ROUND_DEBOUNCE_THRESHOLD=50

# Allocation. GREEDY_BY_VALUE_DENSITY is the default because it accounts for
# slew cost in its denominator; the benchmark in #45 is what justifies that
# choice with numbers rather than intuition.
OVERPASS_ALLOCATION_POLICY=GREEDY_BY_VALUE_DENSITY
OVERPASS_DUTY_CYCLE_BUDGET_SECONDS=600

# Fairness. Multipliers and the ageing curve live here, deliberately outside
# the published contract, so fairness can be re-tuned without versioning a
# schema and clients cannot optimise against a published formula.
OVERPASS_TIER_MULTIPLIER_GOVERNMENT=3.0
OVERPASS_TIER_MULTIPLIER_CIVIL_PROTECTION=2.5
OVERPASS_TIER_MULTIPLIER_COMMERCIAL=1.0
OVERPASS_TIER_MULTIPLIER_BEST_EFFORT=0.5
# Bounded: unbounded ageing eventually lets an ancient trivial request outrank
# an urgent civil-protection one, which is a worse failure than the starvation
# it fixes.
OVERPASS_AGEING_FACTOR_PER_ROUND=0.15
OVERPASS_AGEING_MAX_MULTIPLIER=2.0

# --- Telemetry ----------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
LOG_LEVEL=info
